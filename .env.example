# The production app origin only (e.g. https://app.rakda.id). Until it exists, sign-in
# links are not rendered and every trial action is the waitlist form (worker/index.ts).
# A dev/staging/test host or plain http is ignored.
PUBLIC_APP_URL=https://app.example.invalid
# The operator's contact address: the contact page, the footer, and the form's error text.
PUBLIC_CONTACT_EMAIL=halo@rakda.id
# Defaults to https://rakda.id; set only to point canonical/OG URLs at another host.
PUBLIC_SITE_URL=
