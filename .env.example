# The production app origin only (e.g. https://app.rakda.id). Until it exists, trial and
# sign-in links are not rendered. A dev/staging/test host or plain http is ignored.
PUBLIC_APP_URL=https://app.example.invalid
# Set only this to turn the trial action into "tell me when the trial opens" (a mailto).
PUBLIC_CONTACT_EMAIL=halo@example.invalid
PUBLIC_SITE_URL=https://www.example.invalid
